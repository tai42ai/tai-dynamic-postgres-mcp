PG_HOST=localhost
PG_PORT=5432
# PG_DB, PG_USER, and PG_PASSWORD are required (no defaults); startup fails if unset.
PG_DB=postgres
PG_USER=username
PG_PASSWORD=password

# Per-connection statement_timeout in milliseconds (0 disables).
PG_STATEMENT_TIMEOUT=30000

PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10
PG_POOL_TIMEOUT=10
PG_POOL_MAX_LIFETIME=300

# Directory for generated tool files (defaults to ~/.cache/tai-dynamic-postgres-mcp/tools)
# TOOLS_DIR=/path/to/generated/tools
